{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash",
      "WebFetch",
      "WebSearch",
      "Agent"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fdx *)",
      "Bash(docker compose * down -v*)",
      "Bash(docker volume rm *)",
      "Bash(docker system prune *)",
      "Read(./.env)",
      "Read(./deploy/.env)"
    ]
  }
}
